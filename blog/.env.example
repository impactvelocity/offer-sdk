# Everything has a local default; copy to .env.local only to override.

# Unset: SQLite at ./blog.sqlite3. Set to use Postgres (pnpm db:postgres starts one on :5434).
# DATABASE_URL=postgres://postgres:postgres@localhost:5434/blog

# better-auth. Required in production: openssl rand -base64 32
# BETTER_AUTH_SECRET=
# BLOG_URL=http://localhost:6770

# The Offer API (pnpm dev:api from the repo root).
# OFFER_API_URL=http://localhost:6767
# Only used by /setup (to list dashboard workspaces) and the console's admin checks.
# OFFER_ADMIN_KEY=dev-admin-key
# The dashboard, for the core SDK's OfferClient check.
# OFFER_APP_URL=http://localhost:6768

# Normally written to the database by /setup. Set these to pin an existing app instead.
# OFFER_APP_ID=
# OFFER_SECRET_KEY=
# OFFER_PUBLIC_KEY=

# Where the API (in Docker) delivers webhooks to this app.
# OFFER_WEBHOOK_URL=http://host.docker.internal:6770/api/webhooks

# Optional: connect a PayPal sandbox app during /setup so offers can be published and bought.
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
