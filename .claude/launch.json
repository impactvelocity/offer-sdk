{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "offer-app",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "offer-app",
        "dev"
      ],
      "port": 3001,
      "autoPort": true
    },
    {
      "name": "site",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "site",
        "dev"
      ],
      "port": 6769,
      "autoPort": true
    },
    {
      "name": "api",
      "runtimeExecutable": "docker",
      "runtimeArgs": [
        "compose",
        "up"
      ],
      "port": 6767
    },
    {
      "name": "demo-app-testing",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "demo-app-testing",
        "dev"
      ],
      "port": 6770
    },
    {
      "name": "demo-app-testing-postgres",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "DATABASE_URL=postgres://postgres:postgres@localhost:5434/blog",
        "pnpm",
        "--filter",
        "demo-app-testing",
        "dev"
      ],
      "port": 6770
    }
  ]
}
