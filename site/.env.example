# Where the sign-in and demo links point (the deployed offer-app). Unset: https://app.offersdk.com
# in production builds, http://localhost:6768 in dev.
NEXT_PUBLIC_APP_URL=http://localhost:6768

# PostHog analytics (every event carries project=offersdk). Defaults to the Offer SDK
# project token; set it empty to turn tracking off. Host defaults to https://us.i.posthog.com.
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=
