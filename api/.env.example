# Everything here has a local-development default (src/dev-env.ts); set values to override.
# Production (NODE_ENV=production, as in the Dockerfile) needs them set for real.

# Postgres connection string. On Render, use the database's *Internal* URL.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/offersdk

# Bearer key with full access, including /orgs and the dashboard's /api/auth proxy.
# The dashboard (offer-app) uses the same value as OFFER_API_ADMIN_KEY. Generate a long random value.
ADMIN_API_KEY=

# Dashboard sign-in (better-auth). Required in production: openssl rand -base64 32
BETTER_AUTH_SECRET=
# The dashboard's public URL. Sessions are issued for it and only its origin is trusted.
APP_URL=http://localhost:6768

# Optional
# PORT=3000
# DATABASE_POOL_MAX=10
# AUTH_DATABASE_POOL_MAX=5
# Set to "false" to skip running migrations on boot (then run `bun run migrate` yourself).
# MIGRATE_ON_BOOT=true
# Set to "false" to not run the webhook delivery worker on this instance.
# WEBHOOKS_WORKER=true
# Set to "true" to allow webhook URLs on localhost / private networks (local development only).
# WEBHOOKS_ALLOW_PRIVATE_URLS=false

# PayPal
# The API's public HTTPS URL. When an app connects PayPal, the API registers
# <PUBLIC_API_URL>/paypal/webhooks/<appId> with PayPal. On Render it defaults to the
# service's onrender.com URL (RENDER_EXTERNAL_URL); set it for a custom domain or
# another host. Locally there's no public URL, so webhooks aren't registered.
# PUBLIC_API_URL=https://api.example.com
# Encrypts stored PayPal client secrets. Defaults to BETTER_AUTH_SECRET, then ADMIN_API_KEY.
# Changing the value makes stored secrets unreadable, so apps would have to reconnect PayPal.
# SECRETS_KEY=

# Cancel flows: Claude picks dynamic save offers. Without a key, flows use their static offer.
# ANTHROPIC_API_KEY=
# DECIDE_MODEL=claude-opus-5-5
# DECIDE_TIMEOUT_MS=20000

# Subscription pauses run as Render Workflow tasks (../workflows) when both are set;
# otherwise the API pauses and resumes them in-process.
# RENDER_API_KEY=
# RENDER_WORKFLOW_SLUG=offersdk-workflows
# Set to "false" to not check for due pauses on this instance.
# PAUSE_WORKER=true
# How often to check for due pauses. Default: 10 minutes, or 60 with Render Workflows.
# PAUSE_WORKER_INTERVAL_MS=600000
